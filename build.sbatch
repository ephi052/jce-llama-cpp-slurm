#!/bin/bash
#SBATCH --job-name=llama_build
#SBATCH --output=build_%j.log
#SBATCH --error=build_%j.log
#SBATCH --partition=main
# exlude 1080ti and 2080 nodes since they have insufficient GPU RAM for larger models
#SBATCH --exclude=HPC-GTX1080ti-[01,03-09],HPC-RTX2080-X8,HPC-RTX2080s-[01-03]

#SBATCH --gres=gpu:1
#SBATCH --time=01:00:00

# Override repo/ref/arch at submit time:
#   LLAMA_CPP_REPO=https://github.com/TheTom/llama-cpp-turboquant.git sbatch build.sbatch
#   LLAMA_CPP_REF=<commit-sha> sbatch build.sbatch
#   CUDA_ARCHS=86 sbatch build.sbatch
# See docs/turboquant-track.md

set -e

# ── Preflight checks ──
for cmd in git nvidia-smi; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: '$cmd' not found. Is this a GPU node?"
        exit 1
    fi
done

echo "=========================================="
echo "llama.cpp Latest - CMake Build with CUDA"
echo "=========================================="
echo "Date: $(date)"
echo "Node: $(hostname)"
echo ""

# Configuration - everything lives in the directory from which sbatch was called
INSTALL_DIR="${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
LLAMACPP_DIR="$INSTALL_DIR/llama.cpp"

# Print GPU info
echo "GPU Information:"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null || nvidia-smi -L
echo ""

# Load conda environment for cmake (see docs/conda.md for setup)
echo "Loading conda environment..."
module load anaconda
# 'source activate' works in both interactive and non-interactive (SLURM) shells
source activate llama-build || conda activate llama-build
if ! command -v cmake &>/dev/null; then
    echo "Error: cmake not found after activating 'llama-build' conda env."
    echo "Run: conda create -n llama-build cmake -y  (see docs/conda.md)"
    exit 1
fi
echo "  cmake version: $(cmake --version | head -1)"
echo ""

# CUDA setup
export CUDA_HOME=/usr/local/cuda
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:/usr/lib64:$LD_LIBRARY_PATH
# RTX3070 = sm_86. Override with CUDA_ARCHS=75;86 for a fat binary.
CUDA_ARCHS="${CUDA_ARCHS:-86}"
echo "CUDA version:"
nvcc --version | grep "release"
echo "CUDA arch targets: $CUDA_ARCHS"
echo ""

# Step 1: Clone/Update llama.cpp
echo "Step 1: Setting up llama.cpp (latest)..."
mkdir -p "$INSTALL_DIR"
cd "$INSTALL_DIR"

LLAMA_CPP_REPO="${LLAMA_CPP_REPO:-https://github.com/ggml-org/llama.cpp.git}"
LLAMA_CPP_REF="${LLAMA_CPP_REF:-}"

if [ -d "llama.cpp" ]; then
    EXISTING_REMOTE=$(cd llama.cpp && git remote get-url origin 2>/dev/null || true)
    if [ "$EXISTING_REMOTE" != "$LLAMA_CPP_REPO" ]; then
        echo "  Existing llama.cpp remote ($EXISTING_REMOTE) differs from requested ($LLAMA_CPP_REPO)."
        echo "  Removing and re-cloning..."
        rm -rf llama.cpp
    fi
fi

if [ ! -d "llama.cpp" ]; then
    echo "  Cloning llama.cpp repository from $LLAMA_CPP_REPO ..."
    git clone "$LLAMA_CPP_REPO" llama.cpp
else
    echo "  Updating existing llama.cpp..."
    cd llama.cpp && git fetch && cd ..
fi

if [ -n "$LLAMA_CPP_REF" ]; then
    echo "  Checking out ref: $LLAMA_CPP_REF"
    cd llama.cpp && git checkout "$LLAMA_CPP_REF" && cd ..
else
    echo "  Using latest (tip of default branch)"
    cd llama.cpp && git pull && cd ..
fi
echo ""

# Step 2: Build with CMake + CUDA
echo "Step 2: Building with CMake + CUDA support..."
cd "$LLAMACPP_DIR"

echo "  Cleaning previous build..."
rm -rf build

echo "  Configuring with CMake..."
cmake -B build \
    -DGGML_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES="$CUDA_ARCHS" \
    -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
    -DCMAKE_BUILD_TYPE=Release

echo ""
echo "  Building with $(nproc) cores..."
cmake --build build --config Release -j$(nproc)

echo ""
echo "  ✓ Build complete!"
echo ""

# Step 3: Verify binaries
echo "Step 3: Verifying binaries..."
BINDIR="$LLAMACPP_DIR/build/bin"
if [ -f "$BINDIR/llama-cli" ] && [ -f "$BINDIR/llama-server" ]; then
    ls -lh "$BINDIR/llama-cli" "$BINDIR/llama-server"
    echo "  ✓ Binaries ready"
else
    echo "  ✗ Build failed - binaries not found in $BINDIR"
    ls -lh "$BINDIR/" 2>/dev/null || echo "    (directory not found)"
    exit 1
fi
echo ""

# Step 3b: Record build metadata for reproducible benchmarks
echo "Step 3b: Recording build metadata..."
{
    echo "LLAMA_CPP_REPO=$(cd "$LLAMACPP_DIR" && git remote get-url origin)"
    echo "LLAMA_CPP_REF=$(cd "$LLAMACPP_DIR" && git rev-parse HEAD)"
    echo "LLAMA_CPP_DESCRIBE=$(cd "$LLAMACPP_DIR" && git describe --always --dirty 2>/dev/null || true)"
    echo "CUDA_ARCHS=$CUDA_ARCHS"
    echo "BUILD_DATE=$(date -Iseconds)"
    echo "BUILD_NODE=$(hostname)"
} > "$INSTALL_DIR/llama-build-info.env"
echo "  ✓ Written: $INSTALL_DIR/llama-build-info.env"
cat "$INSTALL_DIR/llama-build-info.env"
echo ""

# Step 4: Generate env.sh
echo "Step 4: Creating environment configuration..."
cd "$INSTALL_DIR"

cat > env.sh << 'EOFENV'
#!/bin/bash
# llama.cpp environment — generated by build.sbatch

ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export LLAMA_CPP_DIR="$ENV_DIR/llama.cpp"
export LLAMA_BIN_DIR="$LLAMA_CPP_DIR/build/bin"
export LLAMA_CACHE="$ENV_DIR/models"
export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib64:$LD_LIBRARY_PATH

# Default model (change with: sbatch models.sbatch <repo:quant>)
export HF_MODEL="Qwen/Qwen2.5-7B-Instruct-GGUF:Q4_K_M"

# Default parameters
export DEFAULT_GPU_LAYERS=99
export DEFAULT_CONTEXT_SIZE=4096
export DEFAULT_PARALLEL=1

echo "env loaded | model: $HF_MODEL | cache: $LLAMA_CACHE"
EOFENV

chmod +x env.sh
echo "  ✓ Created env.sh"
echo ""

echo "=========================================="
echo "✓ Build Complete!"
echo "=========================================="
echo ""
echo "Next steps:"
echo "  1. Download a model:  sbatch models.sbatch Qwen/Qwen2.5-7B-Instruct-GGUF:Q4_K_M"
echo "  2. Start the server:  sbatch server.sbatch"
echo ""
